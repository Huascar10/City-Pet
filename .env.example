# ==============================================================================
# CITYPET PHARMA — PLANTILLA DE VARIABLES DE ENTORNO (.env.example)
# ==============================================================================
# INSTRUCCIONES:
# 1. Para desarrollo local: copia este archivo como `.env` (que está ignorado por Git).
# 2. Para Render (Staging y Production): configura estas variables en el panel
#    "Environment" de cada servicio web en Render.
# 3. NUNCA compartas las mismas claves ni bases de datos entre STAGING y PRODUCTION.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. ENTORNO DE EJECUCIÓN
# ------------------------------------------------------------------------------
# Valores admitidos: development | staging | production | testing
APP_ENV=development
FLASK_CONFIG=development

# ------------------------------------------------------------------------------
# 2. SEGURIDAD Y SESIONES (OBLIGATORIO EN STAGING Y PRODUCTION)
# ------------------------------------------------------------------------------
# Genera una clave única por entorno (mínimo 32 caracteres aleatorios):
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=reemplazar-con-clave-secreta-unica-de-64-caracteres-hex

# Contraseña inicial para el usuario propietario `admin` al ejecutar `flask init-db`
ADMIN_INITIAL_PASSWORD=CambiarPasswordSegura2026!

# ------------------------------------------------------------------------------
# 3. BASE DE DATOS (OBLIGATORIO EN STAGING Y PRODUCTION)
# ------------------------------------------------------------------------------
# Desarrollo local (SQLite opcional):
DATABASE_URL=sqlite:///citypet.db

# Ejemplo para Supabase PostgreSQL (Transaction Pooler puerto 6543 o Session Pooler 5432):
# STAGING:    postgresql://postgres.[PROJECT-REF-STAGING]:[PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require
# PRODUCTION: postgresql://postgres.[PROJECT-REF-PROD]:[PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require

# Ajustes opcionales del pool de conexiones SQLAlchemy para PostgreSQL:
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=300
DB_CONNECT_TIMEOUT=10

# ------------------------------------------------------------------------------
# 4. ALMACENAMIENTO PERSISTENTE DE IMÁGENES (SUPABASE STORAGE)
# ------------------------------------------------------------------------------
# Si se configuran estas 3 variables, CityPet almacena las fotos de productos y logos
# en Supabase Storage para que persistan tras reinicios o despliegues en Render.
# STAGING y PRODUCTION deben usar proyectos y buckets distintos.
SUPABASE_URL=
SUPABASE_KEY=
# En STAGING usar: citypet-staging-media | En PRODUCTION usar: citypet-production-media
SUPABASE_STORAGE_BUCKET=citypet-staging-media

# Límite máximo por imagen subida en bytes (por defecto 5 MB = 5242880)
MAX_IMAGE_SIZE_BYTES=5242880

# ------------------------------------------------------------------------------
# 5. INTEGRACIÓN CON TELEGRAM (INDEPENDIENTE POR ENTORNO)
# ------------------------------------------------------------------------------
# En STAGING mantener en false por defecto (o usar un bot y grupo exclusivos de pruebas)
# En PRODUCTION establecer en true con el bot comercial oficial
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Opcional en STAGING: ID del chat de producción para bloquear envíos accidentales
PRODUCTION_TELEGRAM_CHAT_ID=

# ------------------------------------------------------------------------------
# 6. DATOS INSTITUCIONALES POR DEFECTO
# ------------------------------------------------------------------------------
COMPANY_NAME=CityPet Pharma
COMPANY_RUC=4421912920001B
COMPANY_CURRENCY=C$
